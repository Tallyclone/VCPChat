# Read paths.accountsDir, paths.chromePath, clash.host/port from this existing file.
GAM_SOURCE_CONFIG=G:/profiles-manage/config.json
GAM_ALLOWED_ROOT=G:/profiles-manage
# Exact command-level allowlist, enforced in code (not merely manifest metadata).
GAM_ALLOWED_COMMANDS=list,inspect,proxy_status,find_available_account,launch,proxy_login,close,refresh_proxy_bindings,set_note,set_type,find_and_launch,close_all_managed_profiles,list_outlets,list_groups,list_nodes,login_with_proxy,restore_auto_binding
# stdio uses the trusted local command allowlist; no remote requiresAdmin injection.
# local-policy: explicit local administrator preapproval; no tool argument can set this.
GAM_APPROVAL=local-policy
